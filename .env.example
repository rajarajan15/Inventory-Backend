# Spring profile: `prod` for deployments (API docs off, graceful shutdown), `local` for development
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=inventory_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Configuration
# REQUIRED: random, at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=generate_a_long_random_secret
# Access token lifetime in ms (15 min) and refresh token lifetime (7 days)
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to false in production to hide Swagger UI / OpenAPI docs
API_DOCS_ENABLED=true

# Frontend base URL used in email links ({base}/o/{slug}, {base}/invite/{token}, {base}/platform)
FRONTEND_BASE_URL=http://localhost:5173

# StockWise super admin (seeded once on first start)
SUPER_ADMIN_EMAIL=stockwise.rr.2026@gmail.com
# REQUIRED on first start: 8-64 chars with upper, lower, number and special character
SUPER_ADMIN_PASSWORD=choose_a_strong_password
SUPER_ADMIN_NAME=StockWise Owner

# Email via Gmail SMTP (use a Google App Password, not your Gmail password)
MAIL_ENABLED=false
MAIL_USERNAME=stockwise.rr.2026@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=stockwise.rr.2026@gmail.com
PLATFORM_NOTIFICATION_EMAIL=stockwise.rr.2026@gmail.com

# Seed a "demo" organization with sample data (local development only)
SEED_DEMO_DATA=false
